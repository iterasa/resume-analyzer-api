ASPNETCORE_URLS=http://+:8080

# Entorno. Development admite la llave maestra local del cifrado; sin definir (Production)
# la aplicación exige AWS KMS y no arranca con la local.
ASPNETCORE_ENVIRONMENT=Development

# Tamaño máximo del cuerpo de una petición, en bytes. Por encima, 413.
HTTP_MAX_REQUEST_BODY_BYTES=1048576

# Base de datos
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=resume_analyzer_db;Username=postgres;Password=postgres

# Cifrado de campos (ADR 0015). Obligatorio: sin llave maestra la aplicación no arranca.
# Producción: aws-kms y el id, ARN o alias de la llave de KMS (credenciales y región salen
# del rol de la tarea y de AWS_REGION, nunca de aquí).
# Desarrollo: local y una llave propia, generada con `openssl rand -base64 32`. Nunca la
# subas al repositorio ni la uses fuera de Development.
FIELD_ENCRYPTION_KEK_PROVIDER=local
FIELD_ENCRYPTION_LOCAL_KEK=
# FIELD_ENCRYPTION_KEK_PROVIDER=aws-kms
# FIELD_ENCRYPTION_KMS_KEY_ID=alias/criba-field-encryption

# Logging estructurado: LOG_FORMAT=json en producción, text en desarrollo
LOG_LEVEL=Information
LOG_FORMAT=json

# Documentación: documento OpenAPI en /openapi/v1.json y Swagger UI en /swagger. Título y
# descripción son la identidad de cada proyecto. Desactívala en producción.
SWAGGER_ENABLED=true
API_TITLE=Resume Analyzer API
API_DESCRIPTION=API REST versionada por ruta; los errores siguen Problem Details (RFC 9457).

# CORS. Desactivado salvo que haya un cliente de navegador en otro origen. Los orígenes se
# comparan literalmente (esquema, host y puerto); https://*.dominio.com admite cualquier
# subdominio. Nunca "*". El token Bearer no necesita CORS_ALLOW_CREDENTIALS: solo las cookies.
CORS_ENABLED=false
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://*.example.com,http://localhost:5173
CORS_ALLOW_CREDENTIALS=false
CORS_PREFLIGHT_MAX_AGE_SECONDS=600

# Cabeceras reenviadas por un proxy inverso. Actívalo SOLO si hay un proxy delante y
# declara los proxys/redes de confianza: de lo contrario cualquier cliente podría
# falsear su IP.
FORWARDED_HEADERS_ENABLED=false
# FORWARDED_HEADERS_KNOWN_PROXIES=10.0.0.5,10.0.0.6
# FORWARDED_HEADERS_KNOWN_NETWORKS=10.0.0.0/8
