<?xml version="1.0" encoding="utf-8"?>
<!--
  Orígenes de paquetes del repositorio. <clear /> ignora los que haya configurados en la
  máquina, y el mapeo fija de qué origen sale cada paquete: al añadir un feed privado,
  sus paquetes se declaran ahí con su prefijo y nadie puede suplantarlos publicando el
  mismo nombre en nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
